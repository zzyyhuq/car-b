<view class="page">
  <view class="head card">
    <view>
      <view class="head-title">我的车辆</view>
      <view class="muted">下单前需要选择车辆</view>
    </view>
    <view class="add-btn" bindtap="addCar">＋ 添加车辆</view>
  </view>

  <view class="empty card" wx:if="{{!loading && !cars.length}}">
    <text class="empty-icon">🚗</text>
    <view>还没有添加车辆</view>
    <view class="empty-btn" bindtap="addCar">添加第一辆车</view>
  </view>

  <view class="car-card card" wx:for="{{cars}}" wx:key="id">
    <view class="car-main">
      <view class="car-plate">{{item.plateNo}}</view>
      <view class="muted">{{item.brand}} {{item.model}} · {{item.color}}</view>
    </view>
    <view class="car-actions">
      <text class="edit" data-id="{{item.id}}" bindtap="editCar">编辑</text>
      <text class="delete" data-id="{{item.id}}" bindtap="deleteCar">删除</text>
    </view>
  </view>
</view>
