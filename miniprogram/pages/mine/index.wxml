<view class="page">
  <view class="profile card">
    <view class="avatar">
      <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
      <text wx:else>👤</text>
    </view>
    <view class="profile-info">
      <view class="profile-name">{{nickname}}</view>
      <view class="muted">{{subtitle}}</view>
    </view>
    <view class="points-box" bindtap="goMall">
      <view class="points-num">{{points}}</view>
      <view class="points-label">积分</view>
    </view>
  </view>

  <view class="stat-row card">
    <view class="stat" bindtap="goOrders">
      <view class="stat-num">{{orders.length}}</view>
      <view class="muted">我的订单</view>
    </view>
    <view class="stat" bindtap="goCars">
      <view class="stat-num">{{cars.length}}</view>
      <view class="muted">我的车辆</view>
    </view>
    <view class="stat" bindtap="goMall">
      <view class="stat-num">{{goodsCount}}</view>
      <view class="muted">可兑商品</view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">我的车辆</text>
    <text class="section-more" bindtap="goCars">管理 ›</text>
  </view>
  <view class="car-card card" wx:for="{{cars}}" wx:key="id">
    <view class="car-plate">{{item.plateNo}}</view>
    <view class="muted">{{item.brand}} {{item.model}} · {{item.color}}</view>
  </view>

  <view class="section-head">
    <text class="section-title">我的订单</text>
    <text class="section-more" bindtap="goService">去预约 ›</text>
  </view>

  <view wx:if="{{orders.length === 0}}" class="empty card">
    <text class="empty-icon">🧾</text>
    <view>还没有预约记录</view>
    <view class="empty-btn" bindtap="goService">去预约一个服务</view>
  </view>

  <view
    class="order-card card"
    wx:for="{{orders}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="goOrderDetail"
  >
    <view class="order-top">
      <text class="order-name">{{item.serviceName}}</text>
      <text class="status">{{item.status}}</text>
    </view>
    <view class="order-line">{{item.carPlate}} · {{item.carName}}</view>
    <view class="order-line" wx:if="{{item.date}}">预约时间：{{item.date}} {{item.time}}</view>
    <view class="order-line" wx:else>预约时间：到店确认</view>
    <view class="order-bottom">
      <text class="muted">单号 {{item.orderNo}}</text>
      <text class="price">¥{{item.price}}</text>
    </view>
    <view class="order-more">查看详情与进度 ›</view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="goMall">
      <text>🎁 积分商城</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCars">
      <text>🚗 车辆管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFeedback">
      <text>💬 留言反馈</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMessages">
      <text>📝 我的留言与评价</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
