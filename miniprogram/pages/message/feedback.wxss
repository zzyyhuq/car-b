.block {
  padding: 28rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.tip {
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  height: 320rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  font-size: 27rpx;
  box-sizing: border-box;
}

.counter {
  margin-top: 10rpx;
  text-align: right;
  color: #a3acbb;
  font-size: 22rpx;
}

.submit-btn {
  margin-top: 36rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff, #3aa0ff);
  color: #ffffff;
  text-align: center;
  font-size: 29rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  opacity: 0.6;
}
