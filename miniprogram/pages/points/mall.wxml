<view class="page">
  <view class="mall-head">
    <view class="mall-title">积分商城</view>
    <view class="mall-sub">当前积分 <text class="mall-points">{{points}}</text></view>
  </view>

  <view class="goods-grid">
    <view class="goods-card card" wx:for="{{goods}}" wx:key="id">
      <view class="goods-emoji">{{item.emoji}}</view>
      <view class="goods-name">{{item.name}}</view>
      <view class="goods-desc">{{item.desc}}</view>
      <view class="goods-bottom">
        <text class="goods-points">{{item.points}} 积分</text>
        <view class="exchange-btn" data-id="{{item.id}}" bindtap="exchange">兑换</view>
      </view>
    </view>
  </view>

  <view class="mall-tip">积分兑换将在阶段 4 接入后端接口</view>
</view>
