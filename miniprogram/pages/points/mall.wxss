.mall-head {
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #7c4dff, #b388ff);
  color: #ffffff;
}

.mall-title {
  font-size: 40rpx;
  font-weight: 700;
}

.mall-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.mall-points {
  font-size: 36rpx;
  font-weight: 700;
}

.mall-links {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 16rpx;
  color: #1677ff;
  font-size: 24rpx;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 24rpx;
}

.goods-card {
  width: 48%;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.goods-emoji {
  width: 100%;
  height: 180rpx;
  border-radius: 20rpx;
  background: #f4f7fd;
  font-size: 90rpx;
  line-height: 180rpx;
  text-align: center;
}

.goods-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.goods-desc {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.goods-points {
  color: #ff6b35;
  font-size: 24rpx;
  font-weight: 600;
}

.goods-stock {
  display: block;
  margin-top: 4rpx;
  color: #a3acbb;
  font-size: 20rpx;
}

.exchange-btn {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 22rpx;
}

.exchange-btn.disabled {
  opacity: 0.45;
}

.mall-tip {
  margin-top: 12rpx;
  text-align: center;
  color: #a3acbb;
  font-size: 22rpx;
}
