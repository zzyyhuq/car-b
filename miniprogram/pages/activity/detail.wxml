<view class="page" wx:if="{{activity}}">
  <image
    wx:if="{{activity.cover}}"
    class="cover"
    src="{{activity.cover}}"
    mode="aspectFill"
  />

  <view class="card detail">
    <view class="title">{{activity.title}}</view>
    <view class="time" wx:if="{{activity.startTimeText}}">
      {{activity.startTimeText}} 至 {{activity.endTimeText}}
    </view>
    <view class="content">{{activity.content}}</view>
  </view>

  <view class="signup-card card" wx:if="{{activity.needSignup === 1 && activity.status === 1}}">
    <view class="signup-title">活动报名</view>
    <view class="signup-tip" wx:if="{{signup && signup.status === 1}}">
      你已报名，活动开始前请按时到店
    </view>
    <view class="signup-tip" wx:else>名额有限，报名后到店参加</view>
    <view
      class="signup-btn {{signing ? 'disabled' : ''}}"
      wx:if="{{!(signup && signup.status === 1)}}"
      bindtap="signupActivity"
    >{{signing ? '提交中...' : '立即报名'}}</view>
    <view
      class="signup-btn cancel {{signing ? 'disabled' : ''}}"
      wx:else
      bindtap="cancelSignup"
    >{{signing ? '处理中...' : '取消报名'}}</view>
  </view>
</view>

<view class="empty" wx:elif="{{loading}}">加载中...</view>
<view class="empty" wx:else>活动不存在或已下线</view>
